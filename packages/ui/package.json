{
  "name": "@deckxi/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "contrast": "node scripts/contrast-audit.mjs",
    "contrast:check": "node scripts/contrast-audit.mjs --check",
    "build": "node scripts/generate-tokens.mjs && tsc -b"
  },
  "dependencies": {
    "@deckxi/data": "workspace:*",
    "@deckxi/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0"
  }
}
