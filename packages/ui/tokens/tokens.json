  "semantic": {
    "$comment": [
      "`common` is theme-invariant: scales, plus roles whose value is the same in both",
      "themes. `dark` and `light` carry only what actually differs.",
      "",
      "The card is theme-invariant on purpose: a trump card is a printed object, cream",
      "stock with ink, and it reads the same by day as by night. That is why the card",
      "ink roles live in `common` rather than per-theme."
    ],
    "common": {
      "space": {
        "1": "{space.1}",
        "2": "{space.2}",
        "3": "{space.3}",
        "4": "{space.4}",
        "5": "{space.5}",
        "6": "{space.6}",
        "7": "{space.7}",
        "8": "{space.8}",
        "9": "{space.9}",
        "10": "{space.10}",
        "11": "{space.11}",
        "12": "{space.12}"
      },
      "radius": {
        "$comment": "xs: tags/chips. sm: controls and slots. card: the trump card. md: panels. lg: sheets and the phone shell. pill: round.",
        "xs": "{radius.xs}",
        "sm": "{radius.sm}",
        "card": "{radius.card}",
        "md": "{radius.md}",
        "lg": "{radius.lg}",
        "pill": "{radius.pill}"
      },
