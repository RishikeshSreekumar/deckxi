  "semantic": {
    "$comment": [
      "`common` is theme-invariant: scales, plus roles whose value is the same in both",
      "themes. `dark` and `light` carry only what actually differs."
    ],

    "common": {
      "space": {
        "1": "{space.1}",
        "2": "{space.2}",
        "3": "{space.3}",
        "4": "{space.4}",
        "5": "{space.5}",
        "6": "{space.6}",
        "7": "{space.7}",
        "8": "{space.8}",
        "9": "{space.9}",
        "10": "{space.10}",
        "11": "{space.11}",
        "12": "{space.12}"
      },

      "radius": {
        "$comment": "xs: tags/chips. sm: controls. card: the trump card. md: panels. lg: sheets. pill: round.",
        "xs": "{radius.xs}",
        "sm": "{radius.sm}",
        "card": "{radius.card}",
        "md": "{radius.md}",
        "lg": "{radius.lg}",
        "pill": "{radius.pill}"
      },

      "text": {
        "xs": "{text.xs}",
        "sm": "{text.sm}",
        "md": "{text.md}",
        "lg": "{text.lg}",
        "xl": "{text.xl}",
        "2xl": "{text.2xl}",
        "3xl": "{text.3xl}"
      },

      "leading": {
        "tight": "{leading.tight}",
        "snug": "{leading.snug}",
        "normal": "{leading.normal}",
        "relaxed": "{leading.relaxed}"
      },

      "weight": {
        "regular": "{weight.regular}",
        "medium": "{weight.medium}",
        "semibold": "{weight.semibold}",
        "bold": "{weight.bold}",
        "black": "{weight.black}"
      },

      "tracking": {
        "tight": "{tracking.tight}",
        "normal": "{tracking.normal}",
        "wide": "{tracking.wide}",
        "wider": "{tracking.wider}"
      },

      "font": {
        "sans": "{font.sans}",
        "display": "{font.display}",
        "mono": "{font.mono}"
      },

      "dur": {
        "fast": "{duration.fast}",
        "med": "{duration.med}",
        "slow": "{duration.slow}"
      },

      "ease": {
        "out": "{easing.out}",
        "spring": "{easing.spring}",
        "in-out": "{easing.in-out}"
      },

      "bp": {
        "$comment": "Media queries cannot read custom properties — these exist for JS and container queries. Width queries in CSS use the literal, with the token named in a comment.",
        "sm": "{breakpoint.sm}",
        "md": "{breakpoint.md}",
        "lg": "{breakpoint.lg}",
        "xl": "{breakpoint.xl}"
      },

      "container": {
        "sm": "{container.sm}",
        "md": "{container.md}",
        "lg": "{container.lg}",
        "xl": "{container.xl}"
      },

      "touch-min": "{size.touch-min}",

      "card-ink": "{color.white}"
    },

