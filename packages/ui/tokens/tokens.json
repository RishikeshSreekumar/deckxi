        "team-color": "{color.paper-600}",
        "rarity-star": "{color.amber-700}"
      },

      "composite": {
        "$comment": "Foils are re-tuned, not reused: on a near-white surface a pale gold reads as mud, so the light foils run darker and more saturated and the glows are tighter. Elevation is the printed drop shadow — see the dark block.",

        "ink-line": "{color.ink-850}",
        "edge": "2.5px",

        "interactive-accent-subtle": "rgba(199, 63, 24, 0.14)",
        "interactive-disabled": "rgba(122, 90, 34, 0.18)",
        "surface-scrim": "rgba(27, 20, 16, 0.35)",
        "backdrop": "rgba(27, 20, 16, 0.45)",

        "elevation-flat": "none",
        "elevation-raised": "3px 3px 0 {color.ink-850}",
        "elevation-card": "5px 5px 0 {color.ink-850}",
        "elevation-overlay": "5px 5px 0 {color.ink-850}",
        "elevation-modal": "8px 8px 0 {color.ink-850}",

        "card-face": "linear-gradient(160deg, {color.paper-50}, {color.paper-200})",
        "card-back": "{color.ink-850}",

        "rarity-star-glow": "rgba(180, 83, 9, 0.22)",
        "rarity-star-foil": "linear-gradient(130deg, rgba(180, 83, 9, 0.95), rgba(251, 191, 36, 0.95) 30%, rgba(120, 70, 10, 0.95) 55%, rgba(180, 83, 9, 0.95) 80%)",
        "rarity-legend-glow": "rgba(2, 132, 199, 0.3)",
        "rarity-legend-foil": "linear-gradient(130deg, rgba(2, 132, 199, 0.95), rgba(190, 60, 160, 0.85) 30%, rgba(120, 200, 235, 0.95) 50%, rgba(20, 150, 110, 0.85) 70%, rgba(2, 132, 199, 0.95))",
