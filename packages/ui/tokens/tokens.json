        "elevation-card": "5px 5px 0 {color.paper-400}",
        "elevation-overlay": "5px 5px 0 {color.paper-400}",
        "elevation-modal": "8px 8px 0 {color.paper-400}",

        "card-face": "linear-gradient(160deg, {color.ink-700}, {color.ink-800})",
        "card-back": "{color.ink-900}",

        "rarity-star-glow": "rgba(251, 191, 36, 0.28)",
