      "display": "ui-rounded, \"SF Pro Rounded\", \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, monospace"
