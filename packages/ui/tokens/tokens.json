        "rarity-star": "{color.sun-400}"
      },

      "composite": {
        "$comment": "Elevation is not blur in this system: it is a hard offset in the outline colour, the way a printed board game drops its pieces. --ink-line is that colour, and the one shadow step every panel gets.",

        "ink-line": "{color.paper-400}",
        "edge": "2.5px",

        "interactive-accent-subtle": "rgba(255, 122, 77, 0.18)",
        "interactive-disabled": "rgba(166, 141, 95, 0.22)",
