      "bp": {
        "$comment": "Media queries cannot read custom properties — these exist for JS and container queries. Width queries in CSS use the literal, with the token named in a comment.",
        "sm": "{breakpoint.sm}",
        "md": "{breakpoint.md}",
        "lg": "{breakpoint.lg}",
        "xl": "{breakpoint.xl}"
