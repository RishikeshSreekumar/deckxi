        "rarity-legend-glow": "rgba(56, 189, 248, 0.45)",
        "rarity-legend-foil": "linear-gradient(130deg, rgba(120, 220, 255, 0.9), rgba(255, 160, 235, 0.85) 30%, rgba(255, 255, 255, 0.95) 50%, rgba(140, 255, 190, 0.85) 70%, rgba(120, 220, 255, 0.9))",
        "rarity-legend-ink": "#d7f4ff",
        "holo": "linear-gradient(115deg, transparent 25%, rgba(255, 130, 220, 0.16) 38%, rgba(255, 255, 255, 0.2) 46%, rgba(120, 220, 255, 0.22) 54%, rgba(160, 255, 180, 0.14) 62%, transparent 75%)",
        "holo-opacity": "0.5",
        "card-hairline": "rgba(232, 213, 168, 0.14)",
        "card-rule": "rgba(232, 213, 168, 0.1)"
      }
    },

