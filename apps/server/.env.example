# Local dev: every value below has a working default, so an empty .env is fine.
# Deployments (APP_ENV=staging|production) must set DATABASE_URL,
# BETTER_AUTH_SECRET, BETTER_AUTH_URL and CORS_ORIGINS or the server refuses
# to start. Real values live in Google Secret Manager — see docs/runbook.md.

APP_ENV=development
PORT=3001
HOST=0.0.0.0

# Neon connection string; unset locally means in-memory persistence.
# DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/deckxi?sslmode=verify-full

# Comma-separated origin allowlist for CORS and websocket upgrades. One
# leading `*` label is allowed, for Cloudflare Pages preview deploys.
CORS_ORIGINS=http://localhost:5173

# openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observability. Logs are JSON on stdout — in a deployment that is the whole
# pipeline (Cloud Run ships stdout to Cloud Logging). Defaults: debug locally,
# info deployed.
# LOG_LEVEL=debug
# Build identifier stamped on every log line. Set by the deploy workflow to the
# commit sha; Cloud Run's K_REVISION is used when it isn't.
# RELEASE=

# Bearer token for /metrics and the admin API. Unset (the default) means
# /metrics answers only on loopback — so `curl localhost:3001/metrics` works in
# dev and the endpoint is invisible in a deployment. Min 16 chars.
# ADMIN_TOKEN=

# Comma-separated account emails allowed into /admin. Unset means nobody, and
# a guest's placeholder email can never match.
# ADMIN_EMAILS=you@example.com

# Magic-link email delivery (Resend). Unset locally means the sign-in link is
# printed to this log, which is a usable dev flow. Unset in a deployment means
# magic-link sign-in fails loudly — never silently.
# MAIL_API_KEY=re_xxx
# MAIL_FROM=DeckXI <play@deckxi.rishikeshs.dev>
