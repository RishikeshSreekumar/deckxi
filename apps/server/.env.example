# Local dev: every value below has a working default, so an empty .env is fine.
# Deployments (APP_ENV=staging|production) must set DATABASE_URL,
# BETTER_AUTH_SECRET, BETTER_AUTH_URL and CORS_ORIGINS or the server refuses
# to start. Real values live in Google Secret Manager — see docs/runbook.md.

APP_ENV=development
PORT=3001
HOST=0.0.0.0

# Neon connection string; unset locally means in-memory persistence.
# DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/deckxi?sslmode=verify-full

# Comma-separated origin allowlist for CORS and websocket upgrades. One
# leading `*` label is allowed, for Cloudflare Pages preview deploys.
CORS_ORIGINS=http://localhost:5173

# openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
