# DeckXI server environment
# Copy to .env and fill in values. Never commit .env.

# Port the Fastify server listens on
PORT=3001

# Postgres connection string (Neon in staging/production, local Postgres in dev)
DATABASE_URL=postgres://user:password@localhost:5432/deckxi

# Comma-separated list of allowed web origins for CORS / websockets
CORS_ORIGINS=http://localhost:5173
