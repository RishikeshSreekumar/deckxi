# DeckXI server environment
# Copy to .env and fill in values. Never commit .env.

# Port the Fastify server listens on
PORT=3001

# Postgres connection string (Neon in staging/production, local Postgres in dev)
DATABASE_URL=postgres://user:password@localhost:5432/deckxi

# Comma-separated list of allowed web origins for CORS / websockets
CORS_ORIGINS=http://localhost:5173

# --- Auth (Phase 6) ---------------------------------------------------------

# Session signing secret (required outside local dev; generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=

# The server's public URL — OAuth and magic-link callbacks are built on it
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (optional; the "Continue with Google" button needs both set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
